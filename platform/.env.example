# ─── STA Platform — ตัวอย่างตัวแปรแวดล้อม ───────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (อย่า commit .env ที่มีความลับ)

# ── Backend (.NET) — Supabase Postgres ─────────────────────────────────
# Connection string ของ Supabase: Project Settings → Database → Connection string (URI / pooler)
ConnectionStrings__Default=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<your-password>

# JWT — ความลับต้องยาวอย่างน้อย 32 ตัวอักษร (สุ่มใหม่ต่อการติดตั้ง)
Jwt__Secret=<generate-a-random-64-char-secret>
Jwt__Issuer=sta-platform
Jwt__Audience=sta-platform-web
Jwt__AccessTokenMinutes=60

# STA Core (TypeScript เดิม) — backend คุม platform แล้วสั่ง STA ผ่าน Local API นี้
# ปล่อยว่างไว้เพื่อให้อ่าน token/port จาก service record ของ `sta start` อัตโนมัติ
StaCore__BaseUrl=
StaCore__ServiceRecordPath=
StaCore__Token=

# Bootstrap admin (สร้างครั้งแรกครั้งเดียว ตอน migrate+seed)
STA_ADMIN_PASSWORD=
STA_RUN_MIGRATIONS=0

# ── Frontend (Next.js) ──────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
