{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentclaude.local/schemas/requirement.schema.json",
  "title": "requirement.md structural summary (T53)",
  "description": "Validates the structural summary orchestrator/src/docs/docStructure.ts extracts from a requirement.md — presence of the sections .claude/agents/business-analyst.md's Output template requires. Says nothing about the prose inside them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hasOverview",
    "hasTargetUsers",
    "hasCoreFeatures",
    "hasScope",
    "hasConstraints",
    "hasOpenQuestions",
    "hasDeclined",
    "hasReferences",
    "hasChangeLog"
  ],
  "properties": {
    "hasOverview": { "const": true, "description": "## Overview" },
    "hasTargetUsers": { "const": true, "description": "## Target Users & Roles" },
    "hasCoreFeatures": { "const": true, "description": "## Core Features" },
    "hasScope": { "const": true, "description": "## Scope" },
    "hasConstraints": { "const": true, "description": "## Constraints & Assumptions" },
    "hasOpenQuestions": { "const": true, "description": "## Open Questions" },
    "hasDeclined": { "const": true, "description": "## Declined / Not Pursuing" },
    "hasReferences": { "const": true, "description": "## References — external facts and their source (policies/documentation.md)" },
    "hasChangeLog": { "const": true, "description": "## Change Log" }
  }
}
