{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentclaude.local/schemas/handoff.schema.json",
  "title": "Machine-derived structured handoff reference",
  "description": "A bounded index into authoritative stage documents. It is neither a prose summary nor a verdict or source of truth. Runtime validation additionally caps the UTF-8 serialized record at 2048 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "implements",
    "module",
    "phase",
    "constraint_refs",
    "contract_refs",
    "decision_refs",
    "test_refs",
    "artifact_refs",
    "open_findings",
    "budget"
  ],
  "properties": {
    "task_id": { "$ref": "#/definitions/id" },
    "implements": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(REQ|DES)-[A-Za-z0-9._-]+$" }
    },
    "module": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\.\\.?$)(?![A-Za-z]:)[^/\\\\\\r\\n]+$" },
    "phase": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
    "constraint_refs": { "$ref": "#/definitions/references32" },
    "contract_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produces", "consumes"],
      "properties": {
        "produces": { "$ref": "#/definitions/references32" },
        "consumes": { "$ref": "#/definitions/references32" }
      }
    },
    "decision_refs": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(ADR|RULE)-[A-Za-z0-9._-]+$" }
    },
    "test_refs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(TP-[A-Za-z0-9._-]+|test-plan\\.md#TP-[A-Za-z0-9._-]+)$" }
    },
    "artifact_refs": { "$ref": "#/definitions/references32" },
    "open_findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "summary"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "owner": { "$ref": "#/definitions/reference" },
          "summary": { "$ref": "#/definitions/reference" }
        }
      }
    },
    "budget": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9%][A-Za-z0-9%._~:/#-]*$" },
    "references32": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/reference" } }
  }
}
