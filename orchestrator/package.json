{
  "name": "@agentclaude/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Automates the AgentClaude pipeline's opt-in autonomous mode by driving the real .claude/agents/*.md subagents via the claude CLI",
  "type": "module",
  "bin": {
    "agentclaude-orchestrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "orchestrate": "npm run build --silent && node dist/cli.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
